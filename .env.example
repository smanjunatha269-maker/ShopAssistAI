# OpenRouter API (required for Nemotron LLM generation)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2

# Optional: override MiniLM model cache directory (defaults to /tmp/shopassist-minilm on Vercel)
# MINILM_CACHE_DIR=/tmp/shopassist-minilm

# Supabase (migration script only — use service role key, never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
